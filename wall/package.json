{
  "name": "pezlie",
  "version": "0.3.1",
  "description": "A pan/zoom React canvas over tens of thousands of items, drawn from a baked mip chain of sprites, with a live status color per cell.",
  "license": "MIT",
  "author": "orochi235",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/pezlie.git",
    "directory": "wall"
  },
  "bugs": {
    "url": "https://github.com/orochi235/pezlie/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && rsync -a --include='*/' --include='*.css' --exclude='*' src/ dist/",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "canvas",
    "wall",
    "atlas",
    "sprites",
    "cel"
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@bufbuild/cel": "^0.6.1",
    "@weasel-js/core": "1.7.0",
    "@weasel-js/labkit": "1.7.0",
    "@weasel-js/ui": "1.7.0",
    "apache-arrow": "^21.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^25.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
